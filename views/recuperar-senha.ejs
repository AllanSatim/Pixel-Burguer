<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Senha — Pixel Burguer</title>
  <meta name="description" content="Recupere o acesso à sua conta Pixel Burguer através do envio de instruções para seu e-mail cadastrado.">
  <!-- CSS base mantém o layout; o tema abaixo personaliza cores e componentes. -->
  <link rel="stylesheet" href="/public/assets/css/style.css">
  <link rel="stylesheet" href="/public/assets/css/tema-gamer.css">
</head>
<body>
  <!-- Acessibilidade: permite pular a navegação usando a tecla Tab. -->
  <a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>

  <!-- Recuperação de acesso: recebe o e-mail associado à conta. -->
  <main class="auth-wrapper" id="conteudo-principal">
    <div class="auth-card-recovery">

      <!-- CABEÇALHO COM LOGO -->
      <header class="auth-header">
        <a href="/" class="auth-logo-link" title="Voltar para a página inicial">
          <img src="/public/assets/images/LogoPixelBurguer1.png" alt="Pixel Burguer" class="auth-logo-img">
        </a>
        <div class="auth-icon-circle" aria-hidden="true">
          <i class="fa-solid fa-key"></i>
        </div>
        <h1 class="auth-title">Esqueceu sua senha?</h1>
        <p class="auth-subtitle">Informe o e-mail cadastrado na sua conta para enviarmos as instruções de redefinição.</p>
      </header>

      <!-- ÁREA RESERVADA PARA MENSAGENS FUTURAS -->
      <div id="recovery-feedback" class="auth-alert-area" aria-live="polite">
        <% if (locals.erro) { %>
        <div class="alert-box alert-error" role="alert">
          <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
          <span><%= erro %></span>
        </div>
        <% } %>
        <% if (locals.sucesso) { %>
        <div class="alert-box alert-success" role="status">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <span><%= sucesso %></span>
        </div>
        <% } %>
      </div>

      <!-- FORMULÁRIO DE RECUPERAÇÃO -->
      <form action="/auth/recuperar-senha" method="post" class="auth-form">

        <!-- Campo E-mail -->
        <div class="form-group">
          <label for="recovery-email" class="form-label">E-mail Cadastrado</label>
          <div class="input-icon-group">
            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
            <input 
              type="email" 
              id="recovery-email" 
              name="email" 
              class="form-input" 
              placeholder="seuemail@exemplo.com" 
              required 
              autocomplete="email">
          </div>
        </div>

        <!-- Botão Enviar instruções -->
        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 10px;">
          <span>Enviar instruções</span>
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
        </button>

      </form>

      <!-- RODAPÉ COM LINK PARA VOLTAR AO LOGIN -->
      <footer class="auth-footer">
        <a href="/login" class="btn-back-login">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          <span>Voltar ao login</span>
        </a>
      </footer>

    </div>

    <!-- LINK PARA VOLTAR AO INÍCIO -->
    <div class="auth-back-home">
      <a href="/" class="auth-back-link">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <span>Voltar para a página inicial</span>
      </a>
    </div>
  </main>

  <!-- Primeiro as ações compartilhadas; depois o código específico desta tela. -->
  <script src="/public/assets/js/comum.js"></script>
  <script src="/public/assets/js/recuperar-senha.js"></script>
</body>
</html>