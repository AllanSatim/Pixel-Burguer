<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Central de Comando da Cozinha — Pixel Burguer</title>
  <meta name="description" content="Painel de controle gamer e esteira de produção de pedidos da hamburgueria.">
  <!-- CSS base mantém o layout; o tema abaixo personaliza cores e componentes. -->
  <link rel="stylesheet" href="/public/assets/css/style.css">
  <link rel="stylesheet" href="/public/assets/css/tema-gamer.css">
</head>
<body>
  <!-- Acessibilidade: permite pular a navegação usando a tecla Tab. -->
  <a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>

  <!-- Painel da cozinha: apresenta pedidos, filtros de status e histórico administrativo. -->
  <!-- ===================================================================
       CONTROLES DE FILTRO EM PURO CSS (100% Zero JavaScript)
       Alterna entre: Todos, Recebidos, Em preparo, Prontos e Encerrados
       =================================================================== -->
  <input type="radio" name="order-status-filter" id="filter-all" class="order-filter-radio" checked>
  <input type="radio" name="order-status-filter" id="filter-recebidos" class="order-filter-radio">
  <input type="radio" name="order-status-filter" id="filter-preparo" class="order-filter-radio">
  <input type="radio" name="order-status-filter" id="filter-prontos" class="order-filter-radio">
  <input type="radio" name="order-status-filter" id="filter-finalizados" class="order-filter-radio">

  <div class="app-layout">

    <!-- MENU LATERAL ADMINISTRATIVO -->
    <aside class="sidebar" aria-label="Navegação Administrativa">
      <div>
        <a href="/admin" class="sidebar-brand" title="Pixel Burguer - Painel Admin">
          <img src="/public/assets/images/LogoPixelBurguer1.png" alt="Pixel Burguer" class="logo-img">
        </a>

        <nav class="sidebar-nav">
          <a href="/admin" class="nav-link active" title="Fila de Pedidos (Kanban)">
            <i class="fa-solid fa-gamepad" aria-hidden="true" style="color: var(--neon-cyan);"></i>
            <span>Fila de Pedidos</span>
          </a>
          <a href="#view-historico" class="nav-link" title="Histórico de Vendas">
            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
            <span>Histórico</span>
          </a>
          <a href="/cardapio" class="nav-link" title="Ver Cardápio Público">
            <i class="fa-solid fa-utensils" aria-hidden="true"></i>
            <span>Cardápio</span>
          </a>
          <a href="/" class="nav-link" title="Ir para a Visão do Cliente">
            <i class="fa-solid fa-store" aria-hidden="true"></i>
            <span>Voltar ao Salão</span>
          </a>
          <a href="/auth/logout" class="nav-link" title="Sair da Conta de Administrador" style="margin-top: 16px; color: #FF2E63;">
            <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true" style="color: #FF2E63;"></i>
            <span>Sair do Admin</span>
          </a>
        </nav>
      </div>

      <!-- Rodapé do menu administrativo -->
      <div class="sidebar-footer">
        <img src="/public/assets/images/LogoPixelBurguer1.png" alt="" class="footer-icon" aria-hidden="true">
        <p class="footer-text">Central de Produção &amp; Pedidos Gamer</p>
        <div class="accent-line" aria-hidden="true"></div>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL ADMINISTRATIVA -->
    <div class="main-content">

      <!-- PAINEL SUPERIOR -->
      <main class="page-container" style="padding-top: 28px;">

        <header class="admin-top-bar">
          <div class="admin-title-area">
            <h1>Central de Comando da Cozinha</h1>
            <p>
              <i class="fa-solid fa-gamepad" aria-hidden="true" style="color: var(--neon-cyan);"></i>
              <span>Demonstração visual de pedidos • Dados fictícios • HUD Gamer</span>
            </p>
          </div>

          <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            <!-- Indicador Servidor Aberto -->
            <div class="store-status-badge">
              <span class="status-indicator-dot" aria-hidden="true"></span>
              <span>Modo demonstração • Sem backend</span>
            </div>

            <!-- Perfil do Administrador -->
            <div class="admin-user-profile">
              <div class="admin-avatar">AD</div>
              <div class="admin-user-info">
                <span class="admin-user-name">Carlos Silva</span>
                <span class="admin-user-role">Gerente • Admin Level 99</span>
              </div>
            </div>
          </div>
        </header>

        <!-- SUB-NAV DE TELAS (ABAS RÁPIDAS) -->
        <nav class="admin-view-tabs" aria-label="Seções Administrativas">
          <a href="/admin" class="admin-tab-btn active">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
            <span>Fila de Pedidos (Kanban)</span>
          </a>
          <a href="#view-historico" class="admin-tab-btn">
            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
            <span>Histórico de Vendas</span>
          </a>
        </nav>

        <!-- ===================================================================
             TELA 1: VISÃO GERAL (KANBAN COM FILTRAGEM: TODOS, RECEBIDOS, PREPARO, PRONTOS, ENCERRADOS)
             =================================================================== -->
        <div id="view-visao-geral" class="admin-tab-view" style="display: block;">

          <!-- INDICADORES (KPI CARDS - CLIQUES ALTERNAM O FILTRO PURO CSS) -->
          <section class="kpi-indicators-grid" aria-label="Indicadores de Pedidos">

            <!-- Indicador 1: Recebidos -->
            <label for="filter-recebidos" class="kpi-card kpi-recebidos" title="Clique para filtrar apenas pedidos Recebidos">
              <div class="kpi-info">
                <span class="kpi-label">Pedidos Recebidos</span>
                <span class="kpi-value" id="kpi-val-recebidos">2</span>
                <span class="kpi-sub">Novos pedidos nas mesas</span>
              </div>
              <div class="kpi-icon-box" aria-hidden="true">
                <i class="fa-solid fa-bell"></i>
              </div>
            </label>

            <!-- Indicador 2: Em Preparo -->
            <label for="filter-preparo" class="kpi-card kpi-preparo" title="Clique para filtrar apenas pedidos Em Preparo">
              <div class="kpi-info">
                <span class="kpi-label">Em Preparo na Chapa</span>
                <span class="kpi-value" id="kpi-val-preparo">1</span>
                <span class="kpi-sub">Cozinha montando</span>
              </div>
              <div class="kpi-icon-box" aria-hidden="true">
                <i class="fa-solid fa-fire-burner"></i>
              </div>
            </label>

            <!-- Indicador 3: Prontos / Servir -->
            <label for="filter-prontos" class="kpi-card kpi-prontos" title="Clique para filtrar apenas pedidos Prontos">
              <div class="kpi-info">
                <span class="kpi-label">Prontos para Servir</span>
                <span class="kpi-value" id="kpi-val-prontos">1</span>
                <span class="kpi-sub">Levar à mesa do cliente</span>
              </div>
              <div class="kpi-icon-box" aria-hidden="true">
                <i class="fa-solid fa-bell-concierge"></i>
              </div>
            </label>

            <!-- Indicador 4: Finalizados / Conta Paga -->
            <label for="filter-finalizados" class="kpi-card kpi-finalizados" title="Clique para filtrar apenas pedidos Encerrados">
              <div class="kpi-info">
                <span class="kpi-label">Encerrados (Conta Paga)</span>
                <span class="kpi-value" id="kpi-val-finalizados">1</span>
                <span class="kpi-sub">Contas fechadas hoje</span>
              </div>
              <div class="kpi-icon-box" aria-hidden="true">
                <i class="fa-solid fa-circle-check"></i>
              </div>
            </label>

          </section>

          <!-- BARRA DE FILTROS E BUSCA -->
          <section class="admin-filters-bar" aria-label="Filtros e Ações de Pedidos">
            <div class="filter-groups">
              <!-- Filtro por Status (Controlado 100% via CSS) -->
              <label for="filter-all" class="filter-btn filter-label-all" title="Exibir todos os pedidos em todas as etapas">
                <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                <span>Todos</span>
              </label>

              <label for="filter-recebidos" class="filter-btn filter-label-recebidos" title="Exibir apenas pedidos recebidos">
                <i class="fa-solid fa-bell" aria-hidden="true" style="color: #FFAA16;"></i>
                <span>Recebidos</span>
              </label>

              <label for="filter-preparo" class="filter-btn filter-label-preparo" title="Exibir apenas pedidos em preparo">
                <i class="fa-solid fa-fire-burner" aria-hidden="true" style="color: #00F0FF;"></i>
                <span>Em preparo</span>
              </label>

              <label for="filter-prontos" class="filter-btn filter-label-prontos" title="Exibir apenas pedidos prontos para servir">
                <i class="fa-solid fa-bell-concierge" aria-hidden="true" style="color: #00FF88;"></i>
                <span>Prontos</span>
              </label>

              <label for="filter-finalizados" class="filter-btn filter-label-finalizados" title="Exibir apenas pedidos encerrados">
                <i class="fa-solid fa-circle-check" aria-hidden="true" style="color: #BD00FF;"></i>
                <span>Encerrados</span>
              </label>
            </div>

            <div class="admin-toolbar-actions">
              <!-- Busca de Pedidos -->
              <div class="admin-search-input">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" id="admin-search-field" placeholder="Buscar por mesa, comanda ou cliente..." aria-label="Buscar pedidos">
              </div>

              <!-- Botão Adicionar Novo Pedido -->
              <a href="#modal-add-order" class="btn btn-gamer-cyan btn-sm">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                <span>Novo Pedido</span>
              </a>
            </div>
          </section>

          <!-- FILA DE PEDIDOS — KANBAN COM 4 COLUNAS INTERATIVAS -->
          <section class="kanban-board" aria-label="Fila de Produção e Pedidos">

            <!-- COLUNA 1: RECEBIDOS -->
            <div class="kanban-column col-recebidos">
              <div class="kanban-col-header">
                <div class="kanban-col-title">
                  <i class="fa-solid fa-bell" style="color: #FFAA16;" aria-hidden="true"></i>
                  <span>Recebidos</span>
                </div>
                <span class="col-badge" id="badge-col-recebidos">2 na fila</span>
              </div>
              <div id="kanban-col-recebidos-cards" class="kanban-cards-container">
                
                <!-- Card 1: Mariana Souza -->
                <article class="order-card">
                  <div class="order-header-row">
                    <span class="order-id">#1042</span>
                    <span class="order-time"><i class="fa-regular fa-clock" aria-hidden="true"></i> 19:35 (há 10 min)</span>
                  </div>
                  <div class="order-customer-row">
                    <div class="order-customer">
                      <i class="fa-regular fa-user" aria-hidden="true"></i>
                      <span>Mariana Souza</span>
                    </div>
                  </div>
                  <div class="order-modality-block">
                    <span class="status-tag tag-table"><i class="fa-solid fa-chair"></i> Mesa 04</span>
                    <p class="order-address-text"><i class="fa-solid fa-location-crosshairs"></i> Salão Principal • Próximo ao Setup 01</p>
                  </div>
                  <div class="order-items-list">
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Bacon Burger</span>
                      <span>R$ 27,90</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Batata Frita Crocante</span>
                      <span>R$ 12,90</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Coca-Cola 350ml</span>
                      <span>R$ 7,00</span>
                    </div>
                  </div>
                  <div class="order-notes-box">
                    <i class="fa-regular fa-comment-dots" aria-hidden="true"></i>
                    <span>Obs: Ponto da carne bem passado, refrigerante bem gelado.</span>
                  </div>
                  <div class="order-footer-info">
                    <span class="order-total-price">R$ 47,80</span>
                    <span class="order-payment-method"><i class="fa-solid fa-wallet"></i> PIX (Ao fechar conta)</span>
                  </div>
                  <div class="order-card-actions">
                    <button type="button" class="btn-card-action btn-action-primary">
                      <i class="fa-solid fa-fire-burner" aria-hidden="true"></i>
                      <span>Iniciar preparo</span>
                    </button>
                  </div>
                </article>

                <!-- Card 2: Lucas Almeida -->
                <article class="order-card">
                  <div class="order-header-row">
                    <span class="order-id">#1043</span>
                    <span class="order-time"><i class="fa-regular fa-clock" aria-hidden="true"></i> 19:41 (há 4 min)</span>
                  </div>
                  <div class="order-customer-row">
                    <div class="order-customer">
                      <i class="fa-regular fa-user" aria-hidden="true"></i>
                      <span>Lucas Almeida</span>
                    </div>
                  </div>
                  <div class="order-modality-block">
                    <span class="status-tag tag-table"><i class="fa-solid fa-chair"></i> Mesa 08</span>
                    <p class="order-address-text"><i class="fa-solid fa-location-crosshairs"></i> Salão Superior • Mezanino Gamer</p>
                  </div>
                  <div class="order-items-list">
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">2x</strong> Cheeseburger Clássico</span>
                      <span>R$ 49,80</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Onion Rings Especial</span>
                      <span>R$ 15,90</span>
                    </div>
                  </div>
                  <div class="order-notes-box">
                    <i class="fa-regular fa-comment-dots" aria-hidden="true"></i>
                    <span>Obs: Sem cebola em um dos burgers.</span>
                  </div>
                  <div class="order-footer-info">
                    <span class="order-total-price">R$ 65,70</span>
                    <span class="order-payment-method"><i class="fa-solid fa-wallet"></i> Cartão Crédito (Ao fechar)</span>
                  </div>
                  <div class="order-card-actions">
                    <button type="button" class="btn-card-action btn-action-primary">
                      <i class="fa-solid fa-fire-burner" aria-hidden="true"></i>
                      <span>Iniciar preparo</span>
                    </button>
                  </div>
                </article>

              </div>
            </div>

            <!-- COLUNA 2: EM PREPARO -->
            <div class="kanban-column col-preparo">
              <div class="kanban-col-header">
                <div class="kanban-col-title">
                  <i class="fa-solid fa-fire-burner" style="color: #00F0FF;" aria-hidden="true"></i>
                  <span>Em preparo</span>
                </div>
                <span class="col-badge" id="badge-col-preparo">1 na chapa</span>
              </div>
              <div id="kanban-col-preparo-cards" class="kanban-cards-container">
                
                <!-- Card: Camila Ribeiro -->
                <article class="order-card">
                  <div class="order-header-row">
                    <span class="order-id">#1040</span>
                    <span class="order-time"><i class="fa-regular fa-clock" aria-hidden="true"></i> 19:22 (na chapa)</span>
                  </div>
                  <div class="order-customer-row">
                    <div class="order-customer">
                      <i class="fa-regular fa-user" aria-hidden="true"></i>
                      <span>Camila Ribeiro</span>
                    </div>
                  </div>
                  <div class="order-modality-block">
                    <span class="status-tag tag-counter"><i class="fa-solid fa-gamepad"></i> Balcão 02</span>
                    <p class="order-address-text"><i class="fa-solid fa-location-crosshairs"></i> Consumo no Balcão • Banco 02</p>
                  </div>
                  <div class="order-items-list">
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Combo Duplo Clássico</span>
                      <span>R$ 42,90</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Milkshake de Chocolate</span>
                      <span>R$ 18,90</span>
                    </div>
                  </div>
                  <div class="order-notes-box">
                    <i class="fa-regular fa-comment-dots" aria-hidden="true"></i>
                    <span>Obs: Cortar burger ao meio, servir milkshake junto.</span>
                  </div>
                  <div class="order-footer-info">
                    <span class="order-total-price">R$ 61,80</span>
                    <span class="order-payment-method"><i class="fa-solid fa-wallet"></i> Cartão Débito (Ao fechar)</span>
                  </div>
                  <div class="order-card-actions">
                    <button type="button" class="btn-card-action btn-action-blue">
                      <i class="fa-solid fa-bell-concierge" aria-hidden="true"></i>
                      <span>Marcar como pronto</span>
                    </button>
                  </div>
                </article>

              </div>
            </div>

            <!-- COLUNA 3: PRONTOS -->
            <div class="kanban-column col-prontos">
              <div class="kanban-col-header">
                <div class="kanban-col-title">
                  <i class="fa-solid fa-bell-concierge" style="color: #00FF88;" aria-hidden="true"></i>
                  <span>Prontos para Servir</span>
                </div>
                <span class="col-badge" id="badge-col-prontos">1 para servir</span>
              </div>
              <div id="kanban-col-prontos-cards" class="kanban-cards-container">
                
                <!-- Card: Fernando Gomes -->
                <article class="order-card">
                  <div class="order-header-row">
                    <span class="order-id">#1038</span>
                    <span class="order-time"><i class="fa-regular fa-clock" aria-hidden="true"></i> 19:15 (pronto)</span>
                  </div>
                  <div class="order-customer-row">
                    <div class="order-customer">
                      <i class="fa-regular fa-user" aria-hidden="true"></i>
                      <span>Fernando Gomes</span>
                    </div>
                  </div>
                  <div class="order-modality-block">
                    <span class="status-tag tag-table"><i class="fa-solid fa-chair"></i> Mesa 02</span>
                    <p class="order-address-text"><i class="fa-solid fa-location-crosshairs"></i> Salão Principal • Levar à mesa agora</p>
                  </div>
                  <div class="order-items-list">
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Trufado Artesanal</span>
                      <span>R$ 34,90</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">1x</strong> Batata Frita Crocante</span>
                      <span>R$ 12,90</span>
                    </div>
                  </div>
                  <div class="order-notes-box">
                    <i class="fa-regular fa-comment-dots" aria-hidden="true"></i>
                    <span>Obs: Maionese extra em pote.</span>
                  </div>
                  <div class="order-footer-info">
                    <span class="order-total-price">R$ 47,80</span>
                    <span class="order-payment-method"><i class="fa-solid fa-wallet"></i> Dinheiro (Ao fechar conta)</span>
                  </div>
                  <div class="order-card-actions">
                    <button type="button" class="btn-card-action btn-action-green">
                      <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                      <span>Servido (Conta paga)</span>
                    </button>
                  </div>
                </article>

              </div>
            </div>

            <!-- COLUNA 4: FINALIZADOS -->
            <div class="kanban-column col-finalizados">
              <div class="kanban-col-header">
                <div class="kanban-col-title">
                  <i class="fa-solid fa-circle-check" style="color: #BD00FF;" aria-hidden="true"></i>
                  <span>Conta Paga &amp; Encerrado</span>
                </div>
                <span class="col-badge" id="badge-col-finalizados">1 hoje</span>
              </div>
              <div id="kanban-col-finalizados-cards" class="kanban-cards-container">
                
                <!-- Card: Renata Castro -->
                <article class="order-card" style="opacity: 0.85;">
                  <div class="order-header-row">
                    <span class="order-id">#1035</span>
                    <span class="order-time"><i class="fa-regular fa-clock" aria-hidden="true"></i> 18:50 (Encerrado 19:10)</span>
                  </div>
                  <div class="order-customer-row">
                    <div class="order-customer">
                      <i class="fa-regular fa-user" aria-hidden="true"></i>
                      <span>Renata Castro</span>
                    </div>
                  </div>
                  <div class="order-modality-block">
                    <span class="status-tag tag-table"><i class="fa-solid fa-chair"></i> Mesa 06</span>
                    <p class="order-address-text"><i class="fa-solid fa-location-crosshairs"></i> Mesa liberada e higienizada</p>
                  </div>
                  <div class="order-items-list">
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">2x</strong> Smash Burger Duplo</span>
                      <span>R$ 59,80</span>
                    </div>
                    <div class="order-item-line">
                      <span><strong class="order-item-qty">2x</strong> Coca-Cola 350ml</span>
                      <span>R$ 14,00</span>
                    </div>
                  </div>
                  <div class="order-footer-info">
                    <span class="order-total-price">R$ 73,80</span>
                    <span class="order-payment-method"><i class="fa-solid fa-circle-check"></i> Pago no Cartão de Crédito</span>
                  </div>
                  <div class="order-card-actions">
                    <button type="button" class="btn-card-action btn-action-details">
                      <i class="fa-regular fa-eye" aria-hidden="true"></i>
                      <span>Ver Comanda Encerrada</span>
                    </button>
                  </div>
                </article>

              </div>
            </div>

          </section>

        </div>

        <!-- ===================================================================
             TELA: HISTÓRICO DE VENDAS & COMANDAS ENCERRADAS
             =================================================================== -->
        <div id="view-historico" class="admin-tab-view" style="margin-top: 40px;">
          <div class="section-header">
            <div>
              <h2 class="section-title">Histórico de Comandas Encerradas</h2>
              <p style="color: var(--text-muted); font-size: 14px; margin-top: 4px;">
                Registro completo de todos os pedidos finalizados e contas pagas na lanchonete.
              </p>
            </div>
          </div>

          <div class="history-table-wrapper">
            <table class="history-table">
              <thead>
                <tr>
                  <th># Pedido</th>
                  <th>Horário</th>
                  <th>Mesa</th>
                  <th>Cliente</th>
                  <th>Itens Consumidos</th>
                  <th>Total</th>
                  <th>Pagamento</th>
                </tr>
              </thead>
              <tbody id="history-table-body">
                <tr>
                  <td><strong style="color: var(--neon-cyan);">#1035</strong></td>
                  <td>18:50</td>
                  <td><span class="status-tag tag-table">Mesa 06</span></td>
                  <td><strong>Renata Castro</strong></td>
                  <td>2x Smash Burger Duplo, 2x Coca-Cola 350ml</td>
                  <td><strong style="color: #FFF;">R$ 73,80</strong></td>
                  <td><span style="color: var(--neon-green);">Pago no Cartão de Crédito</span></td>
                </tr>
                <tr>
                  <td><strong style="color: var(--neon-cyan);">#1034</strong></td>
                  <td>18:30</td>
                  <td><span class="status-tag tag-counter">Balcão 01</span></td>
                  <td><strong>Guilherme Santos</strong></td>
                  <td>1x Combo Duplo Clássico</td>
                  <td><strong style="color: #FFF;">R$ 42,90</strong></td>
                  <td><span style="color: var(--neon-green);">Pago no PIX</span></td>
                </tr>
              </tbody>
            </table>
